{
  "name": "logwell",
  "version": "0.1.5",
  "description": "Personal productivity for Obsidian: tasks, categories, calendar, habits, focus and an Eisenhower matrix.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run --project unit && vitest run --project perf",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "e2e": "npm run build && wdio run ./wdio.conf.mts",
    "preversion": "node scripts/release-check.mjs pre && npm run typecheck && npm run lint && npm test",
    "version": "node scripts/release-check.mjs version $npm_package_version"
  },
  "keywords": [
    "obsidian-plugin"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/luxon": "3.7.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.18.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fast-check": "4.10.2",
    "happy-dom": "^20.14.5",
    "mocha": "^12.0.3",
    "obsidian": "1.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "chrono-node": "2.10.1",
    "luxon": "3.7.2",
    "preact": "10.27.2"
  }
}
